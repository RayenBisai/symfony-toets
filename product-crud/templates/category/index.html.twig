{% extends "base.html.twig" %}

{% block title %}Categorieën{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col">
        <h1>📂 Categorieën</h1>
    </div>
    <div class="col text-end">
        <a href="{{ path('category_create') }}" class="btn btn-success">+ Nieuwe Categorie</a>
    </div>
</div>

{% if categories is empty %}
    <div class="alert alert-info">Geen categorieën gevonden. <a href="{{ path('category_create') }}">Maak er een aan!</a></div>
{% else %}
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Naam</th>
                    <th>Beschrijving</th>
                    <th>Producten</th>
                    <th>Aangemaakt</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                <tr>
                    <td><strong>{{ category.name }}</strong></td>
                    <td>{{ category.description|slice(0, 40) }}{% if category.description|length > 40 %}...{% endif %}</td>
                    <td><span class="badge bg-info">{{ category.products|length }}</span></td>
                    <td>{{ category.createdAt|date('d-m-Y') }}</td>
                    <td>
                        <a href="{{ path('category_show', {id: category.id}) }}" class="btn btn-sm btn-info">View</a>
                        <a href="{{ path('category_edit', {id: category.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                        <form method="POST" action="{{ path('category_delete', {id: category.id}) }}" style="display:inline;"
                              onsubmit="return confirm('Zeker weten?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

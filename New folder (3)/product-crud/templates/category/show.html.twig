{% extends "base.html.twig" %}

{% block title %}{{ category.name }} - Details{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col">
        <a href="{{ path('category_index') }}" class="btn btn-secondary">&larr; Terug</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h1 class="card-title">{{ category.name }}</h1>
        
        {% if category.description %}
            <h5>Beschrijving</h5>
            <p>{{ category.description }}</p>
        {% endif %}

        <h5 class="mt-4">Producten in deze categorie ({{ category.products|length }})</h5>
        
        {% if category.products is empty %}
            <p class="text-muted">Geen producten in deze categorie.</p>
        {% else %}
            <div class="row">
                {% for product in category.products %}
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">{{ product.name }}</h6>
                                <p class="card-text text-muted small">{{ product.description|slice(0, 40) }}...</p>
                                <p>
                                    <strong>€{{ product.price }}</strong><br>
                                    <small>Voorraad: {{ product.quantity }}</small>
                                </p>
                                <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-sm btn-info">Details</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="mt-4">
            <a href="{{ path('category_edit', {id: category.id}) }}" class="btn btn-warning">✏️ Bewerken</a>
            
            <form method="POST" action="{{ path('category_delete', {id: category.id}) }}" style="display:inline;"
                  onsubmit="return confirm('Dit kan niet ongedaan gemaakt worden!')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                <button type="submit" class="btn btn-danger">🗑️ Verwijderen</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

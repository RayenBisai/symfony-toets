{% extends "base.html.twig" %}

{% block title %}{{ product.name }} - Details{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col">
        <a href="{{ path('product_index') }}" class="btn btn-secondary">&larr; Terug</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h1 class="card-title">{{ product.name }}</h1>
        
        <div class="row mt-4">
            <div class="col-md-6">
                <h5>Beschrijving</h5>
                <p>{{ product.description }}</p>
                
                <h5>Categorie</h5>
                <p>
                    <a href="{{ path('category_show', {id: product.category.id}) }}" class="badge bg-primary">
                        {{ product.category.name }}
                    </a>
                </p>
            </div>
            <div class="col-md-6">
                <h5>Prijs</h5>
                <p><strong>€{{ product.price }}</strong></p>
                
                <h5>Voorraad</h5>
                <p><strong>{{ product.quantity }} stuks</strong></p>
                
                <h5>Aangemaakt</h5>
                <p>{{ product.createdAt|date('d-m-Y H:i') }}</p>
                
                {% if product.updatedAt %}
                    <h5>Laatste update</h5>
                    <p>{{ product.updatedAt|date('d-m-Y H:i') }}</p>
                {% endif %}
            </div>
        </div>

        <div class="mt-4">
            <a href="{{ path('product_edit', {id: product.id}) }}" class="btn btn-warning">✏️ Bewerken</a>
            
            <form method="POST" action="{{ path('product_delete', {id: product.id}) }}" style="display:inline;"
                  onsubmit="return confirm('Dit kan niet ongedaan gemaakt worden!')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button type="submit" class="btn btn-danger">🗑️ Verwijderen</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
